# Copy to `keystore.properties` (gitignored) and fill in.
#
# storeFile is resolved relative to this directory (apps/android-compose/).
# Without this file — a fresh clone, CI, or debug-only work — the release
# signingConfig is left unconfigured and `bundleRelease` produces an UNSIGNED
# bundle rather than failing. That is deliberate: the build should not require
# a secret it does not need.
#
# The upload key is generated once, with:
#   keytool -genkeypair -v -keystore app/upload-keystore.jks \
#           -alias scribatic-upload -keyalg RSA -keysize 4096 \
#           -validity 10000 -storetype PKCS12
#
# PKCS12 requires storePassword and keyPassword to be identical.
#
# Back the .jks and its password up somewhere durable before the first upload.
# With Play App Signing, Google holds the distribution key and a lost upload key
# can be reset through support — but that is a support ticket and a delay, not a
# command you can run.
storeFile=app/upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=scribatic-upload
keyPassword=CHANGE_ME
