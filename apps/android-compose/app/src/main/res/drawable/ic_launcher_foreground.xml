<?xml version="1.0" encoding="utf-8"?>
<!-- A tangerine ring (the on-device sandbox) around sky-blue voice bars that
     turn into paper-white lines of text. Drawn on a 120-unit grid and scaled
     so the ring sits well inside the 66dp safe circle, clear of every mask
     shape. Also used as the monochrome layer: only its alpha is read there. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.52"
        android:scaleY="0.52"
        android:translateX="22.8"
        android:translateY="22.8">
        <path
            android:pathData="M14,60 A46,46 0 1,0 106,60 A46,46 0 1,0 14,60"
            android:strokeColor="#eb6c36"
            android:strokeWidth="7" />
        <path
            android:pathData="M34,50 V70 M45,40 V80 M56,30 V90"
            android:strokeColor="#7fb0ff"
            android:strokeWidth="7"
            android:strokeLineCap="round" />
        <path
            android:pathData="M68,46 H90 M68,60 H90 M68,74 H90"
            android:strokeColor="#f5f5f5"
            android:strokeWidth="7"
            android:strokeLineCap="round" />
    </group>
</vector>
