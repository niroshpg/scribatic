<?xml version="1.0" encoding="utf-8"?>
<!--
  Transcripts, audio and the vector index are excluded from cloud backup and
  from device-to-device transfer. Nothing derived from a recording is permitted
  to leave the device by any path, including Google's.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
