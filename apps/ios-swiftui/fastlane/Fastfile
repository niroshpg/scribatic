default_platform(:ios)

APP_ID  = "com.scribatic.app".freeze
# The Background Assets downloader extension (ADR-011). Needs its own App ID
# and profile, and both IDs need the App Groups capability with
# group.com.scribatic.app assigned — see docs/RELEASING.md.
DOWNLOADER_ID = "com.scribatic.app.downloader".freeze
# App Store Connect's numeric id for the app, used to attach asset packs.
ASC_APP_APPLE_ID = "6811857809".freeze
SCHEME  = "ScribaticApp".freeze
PROJECT = "Scribatic.xcodeproj".freeze
IPA_DIR = "build".freeze

# Overridable, because no single simulator name is installed on every machine:
#   bundle exec fastlane test DEVICE='iPhone 16 Pro'
DEVICE = ENV["DEVICE"] || "iPhone 16"

# The .xcodeproj is a build artefact generated by XcodeGen from project.yml and
# is never committed, so every lane regenerates it first. Editing the generated
# project would be erased on the next run; project.yml is the source of truth.
def regenerate_project
  Dir.chdir("..") do
    UI.user_error!("xcodegen not found — brew install xcodegen") unless system("command -v xcodegen > /dev/null 2>&1")
    sh_in_dir = system("xcodegen generate")
    UI.user_error!("xcodegen failed") unless sh_in_dir
  end
end

# App Store Connect API key. Preferred over Apple ID + app-specific password: no
# 2FA prompt, works unattended, and is the only option that will work from CI.
#
# Generate at App Store Connect > Users and Access > Integrations > App Store
# Connect API. You get a Key ID, an Issuer ID and a .p8 that downloads exactly
# once. Put the .p8 at fastlane/AuthKey.p8 and the ids in fastlane/.env — all
# three are gitignored, and this repository is public.
def asc_api_key
  key_path = "fastlane/AuthKey.p8"
  unless File.exist?("../#{key_path}") && ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]
    UI.user_error!(
      "App Store Connect API key missing. Need fastlane/AuthKey.p8 plus " \
      "ASC_KEY_ID and ASC_ISSUER_ID — see fastlane/.env.example."
    )
  end
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: key_path,
    in_house: false
  )
end

# Build numbers must increase within a marketing version, and
# CURRENT_PROJECT_VERSION lives in a *generated* project file — incrementing it
# in place would be erased by the next `xcodegen generate`. So it is passed to
# xcodebuild instead, never written. A UTC timestamp is monotonic without
# needing any state stored anywhere.
def build_number
  ENV["BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M")
end

platform :ios do
  desc "Run the unit test suite on a simulator"
  lane :test do
    regenerate_project
    run_tests(project: PROJECT, scheme: SCHEME, device: DEVICE, clean: false)
  end

  desc "Create the distribution certificate and App Store provisioning profile"
  desc "Needs no registered device, which is the whole point of doing it this way."
  lane :signing do
    api_key = asc_api_key

    # Automatic signing cannot archive on a team with zero devices: the archive
    # step resolves a *development* profile first, and a development profile
    # must contain at least one device. Distribution profiles have no such
    # requirement, so creating one explicitly and signing manually is what makes
    # a device-free archive possible.
    #
    # This is `match`'s mechanism without `match`'s git repo. If a second
    # machine or CI ever appears, `match import` can adopt this certificate.
    get_certificates(api_key: api_key, development: false)
    get_provisioning_profile(api_key: api_key, development: false, app_identifier: DOWNLOADER_ID)
    downloader_profile = lane_context[SharedValues::SIGH_NAME]
    # The app's profile last, so SIGH_NAME is the app's for callers.
    get_provisioning_profile(api_key: api_key, development: false, app_identifier: APP_ID)

    UI.success("Profiles ready: #{lane_context[SharedValues::SIGH_NAME]}, #{downloader_profile}")
    downloader_profile
  end

  desc "Archive and export a signed App Store .ipa. Does not upload."
  lane :build do
    number = build_number
    UI.message("Build number #{number}")

    # project.yml deliberately does not carry DEVELOPMENT_TEAM: this repository
    # is public, and a team id is an account identifier. Without it the archive
    # fails with "Signing for ScribaticApp requires a development team", so it
    # is passed through at build time from fastlane/.env instead.
    team = ENV["DEVELOPMENT_TEAM"]
    UI.user_error!("DEVELOPMENT_TEAM is not set — see fastlane/.env.example") if team.nil? || team.empty?

    regenerate_project
    downloader_profile = signing
    profile = lane_context[SharedValues::SIGH_NAME]

    # Manual signing, per target, written into the freshly generated project
    # rather than into project.yml, so day-to-day simulator work stays on
    # automatic signing. Per target because the app and the downloader
    # extension each have their own profile; a command-line
    # PROVISIONING_PROFILE_SPECIFIER would apply one profile to both.
    { "ScribaticApp" => profile, "ScribaticDownloader" => downloader_profile }.each do |target, name|
      update_code_signing_settings(
        path: PROJECT, targets: [target], use_automatic_signing: false,
        team_id: team, code_sign_identity: "Apple Distribution", profile_name: name
      )
    end

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: IPA_DIR,
      codesigning_identity: "Apple Distribution",
      export_options: { provisioningProfiles: { APP_ID => profile, DOWNLOADER_ID => downloader_profile } },
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{number}",
        "DEVELOPMENT_TEAM=#{team}"
      ].join(" ")
    )
  end

  desc "Package the model asset packs and upload them to App Store Connect"
  desc "Once per model change, not per build: packs are versioned separately (ADR-011)."
  lane :asset_packs do |options|
    api_key = asc_api_key
    out = File.expand_path("../../../build/asset-packs", __dir__)
    models = File.expand_path("../../../models", __dir__)
    staging = File.expand_path("../../../build/asset-pack-staging", __dir__)
    files = {
      "models-core" => %w[ggml-base.bin ggml-small-q8_0.bin speaker-segmentation.onnx speaker-embedding.onnx embed-minilm-l6-v2.gguf],
      "models-answers" => %w[insight-q4_k_m.gguf]
    }
    FileUtils.mkdir_p(out)
    # `fastlane asset_packs only:models-core` uploads one pack, for when disk
    # space or bandwidth only allows one at a time.
    files = files.select { |pack, _| pack == options[:only] } if options[:only]
    files.each do |pack, names|
      # Each pack's files live in a directory named after the pack: the app
      # resolves them through that directory, the workaround for iOS 26.0's
      # AssetPackManager.url(for:) bug with file paths. APFS clones, so
      # staging costs no copy time and no space.
      FileUtils.rm_rf("#{staging}/#{pack}")
      FileUtils.mkdir_p("#{staging}/#{pack}")
      names.each { |n| sh("cp -c #{File.join(models, n).shellescape} #{File.join(staging, pack, n).shellescape}") }
      manifest = File.expand_path("../AssetPacks/#{pack}.json", __dir__)
      # ba-package resolves the manifest's paths against the working directory.
      sh("cd #{staging.shellescape} && xcrun ba-package package #{manifest.shellescape} -o #{out}/#{pack}.aar")
      sh("xcrun altool --upload-asset-pack #{out}/#{pack}.aar --apple-id #{ASC_APP_APPLE_ID} " \
         "--api-key #{ENV['ASC_KEY_ID']} --api-issuer #{ENV['ASC_ISSUER_ID']} " \
         "--p8-file-path #{File.expand_path('AuthKey.p8', __dir__).shellescape}")
      # 1.5 GB of archives; the upload is done with them.
      FileUtils.rm_f("#{out}/#{pack}.aar")
    end
    FileUtils.rm_rf(staging)
  end

  desc "Push the App Store listing: text, categories, review notes and screenshots"
  desc "Never uploads a binary and never submits. See docs/app-store-listing.md."
  lane :listing do
    # Anchored to this file: a lane runs in fastlane/, so a relative
    # "fastlane/metadata" would resolve to fastlane/fastlane/metadata.
    metadata = File.expand_path("metadata", __dir__)
    screenshots = File.expand_path("screenshots", __dir__)
    # App Store Connect refuses to create the review record without a contact
    # phone number, and only says "No data". These files are gitignored.
    phone = File.join(metadata, "review_information", "phone_number.txt")
    UI.user_error!("#{phone} is missing: App Review needs a contact phone number.") unless File.exist?(phone)

    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      metadata_path: metadata,
      screenshots_path: screenshots,
      skip_binary_upload: true,
      # Clears the store's screenshot sets first, so a rerun replaces rather
      # than adds. deliver's post-upload check can still double-upload if it
      # runs before Apple registers the images: check the counts afterwards.
      overwrite_screenshots: true,
      # Submitting is a deliberate decision, never a side effect of a typo fix.
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build and upload to TestFlight for internal testers"
  desc "Internal testing needs no Beta App Review; builds appear within minutes."
  lane :beta do
    api_key = asc_api_key
    build
    upload_to_testflight(
      api_key: api_key,
      # Internal testers only. Distributing externally triggers Beta App Review,
      # which should be a deliberate decision rather than a side effect.
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )
  end
end
