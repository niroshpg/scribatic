# Copy to fastlane/.env (gitignored) and fill in.
#
# This repository is PUBLIC, so unlike a private project none of these may be
# hardcoded in the Appfile — not even the Apple ID or Team ID, which are not
# secrets but are still account identifiers worth keeping out of a public tree.

# The Apple ID your developer account uses.
FASTLANE_APPLE_ID=

# Team ID (the membership, not a person). Apple Developer > Membership details.
DEVELOPMENT_TEAM=

# App Store Connect API key, from
# App Store Connect > Users and Access > Integrations > App Store Connect API.
# The .p8 downloads exactly once; save it as fastlane/AuthKey.p8 (gitignored).
ASC_KEY_ID=
ASC_ISSUER_ID=
