# --- Build artefacts ---------------------------------------------------------
build/
.cxx/
*.o
*.a
*.so
compile_commands.json

# --- iOS ---------------------------------------------------------------------
# The .xcodeproj is generated from project.yml by `make setup-ios`. Committing
# an unmergeable pbxproj blob is how build settings silently drift.
apps/ios-swiftui/*.xcodeproj
apps/ios-swiftui/*.xcworkspace
apps/ios-swiftui/ScribaticCore/include
DerivedData/
*.xcuserstate

# --- Android -----------------------------------------------------------------
apps/android-compose/.gradle/
apps/android-compose/local.properties
apps/android-compose/**/build/
*.apk
*.aab

# --- Signing and release credentials -----------------------------------------
# Nothing in this section may ever be committed. The repository is public, and
# an upload key or an API key in history is a rotation exercise, not a mistake
# you can quietly delete. Templates ending in .template are the tracked half.
*.keystore
*.jks
keystore.properties
**/fastlane/.env
.env
*.env
!*.env.example
**/fastlane/AuthKey*.p8
*.p8
**/fastlane/play-service-account.json
# Dropped into the tree by fastlane's get_certificates / get_provisioning_profile.
# The .p12 carries the distribution private key; none of it belongs in git.
*.mobileprovision
*.cer
*.p12
*.certSigningRequest
**/fastlane/report.xml
**/fastlane/README.md
**/fastlane/Preview.html
**/fastlane/test_output/
**/fastlane/screenshots/

# --- Model weights -----------------------------------------------------------
# Hundreds of MB each; fetched via `make fetch-models`.
models/*.bin
models/*.gguf
models/*.onnx
models/fixtures/

# --- Editor ------------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Local session notes -----------------------------------------------------
CONTEXT.md

# Vendored backend static libraries, built by `make setup-ios-backends`.
apps/ios-swiftui/vendor-lib/

# Pinned third-party native code fetched by scripts/fetch_native_deps.sh.
core/database/vendor/
core/engine/vendor-bin/

# --- DMARC aggregate reports -------------------------------------------------
# Daily XML/zip reports mailed by Gmail, Outlook et al. to the rua= address in
# the _dmarc.scribatic.com TXT record. Kept locally for inspection, not vendored.
ops/dmarc/*.zip
ops/dmarc/*.gz
ops/dmarc/*.xml

# Kotlin incremental-compilation scratch dir.
apps/android-compose/.kotlin/

# Local working notes for AI sessions. Never committed — machine-specific
# paths, device identifiers and in-progress context.
claude-notes/

# Play asset packs are staged from models/ by `make stage-asset-packs`.
apps/android-compose/models-*/src/

# fastlane's gems install per app (`bundle config set --local path
# vendor/bundle`), not into Homebrew's Ruby, whose plugin stubs are
# read-only symlinks that make `bundle install` fail with EACCES.
apps/*/vendor/bundle/
apps/*/.bundle/

# App Review contact details: personal, and this repository is public. Kept
# locally beside the listing; review_information/notes.txt is committed.
apps/ios-swiftui/fastlane/metadata/review_information/first_name.txt
apps/ios-swiftui/fastlane/metadata/review_information/last_name.txt
apps/ios-swiftui/fastlane/metadata/review_information/email_address.txt
apps/ios-swiftui/fastlane/metadata/review_information/phone_number.txt

# Scribatic Pro: the private repo is cloned here; never part of this one.
/pro/
