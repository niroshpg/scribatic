# --- Build artefacts ---------------------------------------------------------
build/
.cxx/
*.o
*.a
*.so
compile_commands.json

# --- iOS ---------------------------------------------------------------------
# The .xcodeproj is generated from project.yml by `make setup-ios`. Committing
# an unmergeable pbxproj blob is how build settings silently drift.
apps/ios-swiftui/*.xcodeproj
apps/ios-swiftui/*.xcworkspace
apps/ios-swiftui/ScribaticCore/include
DerivedData/
*.xcuserstate

# --- Android -----------------------------------------------------------------
apps/android-compose/.gradle/
apps/android-compose/local.properties
apps/android-compose/**/build/
*.apk
*.aab

# --- Signing and release credentials -----------------------------------------
# Nothing in this section may ever be committed. The repository is public, and
# an upload key or an API key in history is a rotation exercise, not a mistake
# you can quietly delete. Templates ending in .template are the tracked half.
*.keystore
*.jks
keystore.properties
**/fastlane/.env
.env
*.env
!*.env.example
**/fastlane/AuthKey*.p8
*.p8
**/fastlane/play-service-account.json
# Dropped into the tree by fastlane's get_certificates / get_provisioning_profile.
# The .p12 carries the distribution private key; none of it belongs in git.
*.mobileprovision
*.cer
*.p12
*.certSigningRequest
**/fastlane/report.xml
**/fastlane/README.md
**/fastlane/Preview.html
**/fastlane/test_output/
**/fastlane/screenshots/

# --- Model weights -----------------------------------------------------------
# Hundreds of MB each; fetched via `make fetch-models`.
models/*.bin
models/*.gguf

# --- Editor ------------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Local session notes -----------------------------------------------------
CONTEXT.md

# Vendored backend static libraries, built by `make setup-ios-backends`.
apps/ios-swiftui/vendor-lib/

# --- DMARC aggregate reports -------------------------------------------------
# Daily XML/zip reports mailed by Gmail, Outlook et al. to the rua= address in
# the _dmarc.scribatic.com TXT record. Kept locally for inspection, not vendored.
ops/dmarc/*.zip
ops/dmarc/*.gz
ops/dmarc/*.xml

# Kotlin incremental-compilation scratch dir.
apps/android-compose/.kotlin/
